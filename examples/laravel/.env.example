APP_NAME="Atoms Laravel Example"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stderr

ATOMS_ENVIRONMENT=production
ATOMS_ENDPOINT=http://127.0.0.1:8787
# 32 random bytes, base64 (`openssl rand -base64 32`), identical on the
# Worker, never sent anywhere. AtomsClient derives its outbound bearer from
# this, and the callback kernel derives its inbound HMAC verification key
# from it the same way.
ATOMS_SHARED_SECRET=
# Set during a rotation window (old secret here, new one in
# ATOMS_SHARED_SECRET) so inbound callbacks signed under either secret
# verify — see docs/shared-secret.md.
# ATOMS_SHARED_SECRET_PREVIOUS=
ATOMS_CALLBACK_PATH=/atoms/callback
ATOMS_CALLBACK_TIMESTAMP_WINDOW=300
