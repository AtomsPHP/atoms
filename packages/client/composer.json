{
    "name": "atoms/client",
    "description": "Framework-agnostic monolith-side SDK for Atoms: RPC stub proxies, callback kernel, manifest loader.",
    "version": "0.1.1",
    "license": "MIT",
    "homepage": "https://atomsphp.dev",
    "support": {
        "docs": "https://docs.atomsphp.dev",
        "issues": "https://github.com/AtomsPHP/atoms/issues",
        "source": "https://github.com/AtomsPHP/atoms"
    },
    "type": "library",
    "keywords": [
        "atoms",
        "sdk",
        "rpc"
    ],
    "require": {
        "php": "^8.3",
        "atoms/core": "^0.1",
        "psr/container": "^1.1 || ^2.0",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/http-server-handler": "^1.0",
        "psr/http-server-middleware": "^1.0",
        "psr/log": "^2.0 || ^3.0"
    },
    "autoload": {
        "psr-4": {
            "Atoms\\Client\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoms\\Client\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
