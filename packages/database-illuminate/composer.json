{
    "name": "atoms/database-illuminate",
    "description": "Illuminate bridge for Atoms: the Laravel query builder and Eloquent models against an Atom's own SQLite database.",
    "version": "0.6.0",
    "license": "MIT",
    "homepage": "https://atomsphp.dev",
    "support": {
        "docs": "https://docs.atomsphp.dev",
        "issues": "https://github.com/AtomsPHP/atoms/issues",
        "source": "https://github.com/AtomsPHP/atoms"
    },
    "type": "library",
    "keywords": [
        "atoms",
        "eloquent",
        "database"
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*",
        "atoms/core": "^0.6",
        "illuminate/database": "^12.0"
    },
    "suggest": {
        "atoms/testing": "AtomHarness drives an Atom against a real SQLite file, bridge included, in plain PHPUnit."
    },
    "autoload": {
        "psr-4": {
            "Atoms\\DatabaseIlluminate\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoms\\DatabaseIlluminate\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
