{
    "name": "atoms/phpstan-rules",
    "description": "PHPStan rules enforcing the Atoms boundary: no framework symbols in Atom code, serialization-algebra checks, Shared-zone purity.",
    "version": "0.1.2",
    "license": "MIT",
    "homepage": "https://atomsphp.dev",
    "support": {
        "docs": "https://docs.atomsphp.dev",
        "issues": "https://github.com/AtomsPHP/atoms/issues",
        "source": "https://github.com/AtomsPHP/atoms"
    },
    "type": "phpstan-extension",
    "keywords": [
        "atoms",
        "phpstan",
        "static analysis"
    ],
    "require": {
        "php": "^8.3",
        "atoms/core": "^0.1",
        "phpstan/phpstan": "^2.0"
    },
    "autoload": {
        "psr-4": {
            "Atoms\\PHPStan\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoms\\PHPStan\\Tests\\": "tests/"
        }
    },
    "extra": {
        "phpstan": {
            "includes": [
                "rules.neon"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
