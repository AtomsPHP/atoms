{
    "name": "atoms/core",
    "description": "The Atoms runtime ABI: everything an Atom class can touch. Zero framework dependencies.",
    "version": "0.3.1",
    "license": "MIT",
    "homepage": "https://atomsphp.dev",
    "support": {
        "docs": "https://docs.atomsphp.dev",
        "issues": "https://github.com/AtomsPHP/atoms/issues",
        "source": "https://github.com/AtomsPHP/atoms"
    },
    "type": "library",
    "keywords": [
        "atoms",
        "actors",
        "runtime"
    ],
    "require": {
        "php": "^8.3",
        "ext-pdo": "*"
    },
    "suggest": {
        "ext-pdo_sqlite": "Required to use Atoms\\Sqlite\\SqliteDatabase and run migrations locally"
    },
    "autoload": {
        "psr-4": {
            "Atoms\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoms\\Core\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
