{
    "name": "atoms/cli",
    "description": "The `atoms` command-line tool: init, make, validate, build (closure walk + scoper), deploy, rollback, local, ai:install.",
    "version": "0.3.1",
    "license": "MIT",
    "homepage": "https://atomsphp.dev",
    "support": {
        "docs": "https://docs.atomsphp.dev",
        "issues": "https://github.com/AtomsPHP/atoms/issues",
        "source": "https://github.com/AtomsPHP/atoms"
    },
    "type": "library",
    "keywords": [
        "atoms",
        "cli",
        "build"
    ],
    "require": {
        "php": "^8.3",
        "ext-curl": "*",
        "ext-json": "*",
        "atoms/core": "^0.3",
        "colinodell/json5": "^2.3 || ^3.0",
        "nikic/php-parser": "^5.0",
        "symfony/console": "^6.4 || ^7.0",
        "symfony/filesystem": "^6.4 || ^7.0",
        "symfony/process": "^6.4 || ^7.0"
    },
    "suggest": {
        "humbug/php-scoper": "Required for full builds (`atoms build`); `atoms validate` and `--fast` builds work without it"
    },
    "bin": [
        "bin/atoms"
    ],
    "autoload": {
        "psr-4": {
            "Atoms\\Cli\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Atoms\\Cli\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    }
}
