{
	"name": "atoms-conformance",
	"private": true,
	"type": "module",
	"version": "0.0.0",
	"description": "Atoms on Cloudflare: one generic AtomDurableObject hosting a parked PHP loop.",
	"license": "MIT",
	"dependencies": {
		"@atomsphp/php-wasm-8-3": "8.3.32-atoms.7",
		"@atomsphp/php-wasm-8-4": "8.4.28-atoms.7",
		"@atomsphp/php-wasm-8-5": "8.5.13-atoms.7"
	},
	"devDependencies": {
		"wrangler": "4.165.0"
	},
	"scripts": {
		"prepare": "node scripts/prepare-runtime.mjs --if-installed && node scripts/build-bundle.mjs",
		"prepare-runtime": "node scripts/prepare-runtime.mjs",
		"bundle": "node scripts/build-bundle.mjs",
		"bundle:cli": "node scripts/bundle-from-cli.mjs",
		"package:runtime": "node scripts/pack-runtime.mjs",
		"test:package": "node test/runtime-package.mjs",
		"test:instance": "node test/atom-do-instance.test.mjs",
		"predev": "npm run bundle",
		"dev": "wrangler dev",
		"predev:callback": "npm run bundle",
		"dev:callback": "node scripts/dev-with-callback.mjs",
		"deploy": "wrangler deploy",
		"test": "node test/conformance.mjs"
	}
}
