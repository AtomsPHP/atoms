{
	"$schema": "node_modules/wrangler/config-schema.json",

	// YOUR FILE. This is the one file in the Atoms Worker directory that you
	// own: `atoms-runtime-cloudflare init` writes it once, and
	// `atoms-runtime-cloudflare upgrade` leaves it as it is. Edit it, commit
	// it, and your edits are durable — the directory is part of your repository.
	// (See README.md in this directory for the full runtime/user split.)
	//
	// The keys marked RUNTIME-REQUIRED below are what the runtime needs from
	// this file to load at all. A release that changes one says so in its
	// changelog rather than changing it behind your back. Everything else —
	// name, vars, observability, placement, limits — is yours to set.
	//
	// HOW THIS FILE IS USED. `atoms deploy` and `atoms dev` do not hand this
	// file to Wrangler as it is. They derive a copy for the selected
	// atoms.json environment, written to `.wrangler/deploy/wrangler.json`
	// beside a `config.json` that points Wrangler at it (Wrangler's
	// "generated configuration" redirect), and remove both once Wrangler has
	// exited. In that copy `name` is the environment's `worker_name`, `routes`
	// is built from its `custom_domains`, the callback URL and
	// debug-endpoints switch are merged into `vars`, and any `env` blocks are
	// dropped. Everything else here travels through unchanged. Wrangler says
	// "Using redirected Wrangler configuration" when it reads the copy.
	//
	// So: per-environment settings — the Worker name, custom domains,
	// callback URL, debug endpoints — belong in atoms.json. Routes or custom
	// domains declared here at the top level are ignored, and `atoms deploy`
	// says so.
	//
	// (Monorepo note: this is `wrangler.scaffold.jsonc`, which
	// `scripts/pack-runtime.mjs` ships as the template's `wrangler.jsonc`. The
	// sibling `wrangler.jsonc` in the monorepo is the conformance-harness config
	// and is NOT what customers receive — keep the two in sync structurally,
	// and keep the differences (worker name, debug endpoints) deliberate.)

	// Cosmetic: the generated config replaces it with the environment's
	// `worker_name` from atoms.json (required for every environment).
	"name": "atoms-worker",

	// RUNTIME-REQUIRED: the Worker entrypoint the runtime ships.
	"main": "src/index.js",

	// RUNTIME-REQUIRED as a floor: a newer date is fine, an older one is not.
	"compatibility_date": "2026-08-01",

	// RUNTIME-REQUIRED: the php-wasm Emscripten glue takes the
	// ENVIRONMENT_IS_NODE branch under workerd (process.release.name === 'node')
	// and require()s 'events'. Without nodejs_compat the module fails to load.
	// Add flags of your own; do not remove this one.
	"compatibility_flags": ["nodejs_compat"],

	// RUNTIME-REQUIRED: the pinned PHP runtime is bundled as a precompiled wasm
	// module (workerd forbids compiling bytes at runtime) and handed to
	// Emscripten through the instantiateWasm hook in src/php-host.js.
	"rules": [
		{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
		{ "type": "Text", "globs": ["**/*.php"], "fallthrough": true },
		{ "type": "Data", "globs": ["**/*.data", "**/*.so"], "fallthrough": true }
	],

	// RUNTIME-REQUIRED: one generic SQLite-backed Durable Object class for
	// every Atom type — atom type and id are application data, not DO class
	// names. The binding name and class name are what src/index.js looks up.
	"durable_objects": {
		"bindings": [{ "name": "ATOMS", "class_name": "AtomDurableObject" }]
	},
	// RUNTIME-REQUIRED: Wrangler migrations are append-only. A later release
	// may need a new tag here; its changelog will say which.
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AtomDurableObject"] }],

	// Operational values live in env, with defaults resolved in src/config.js.
	//
	// ATOMS_SHARED_SECRET is a secret, never a var here:
	// `wrangler secret put ATOMS_SHARED_SECRET` with the base64 of 32 random
	// bytes (`openssl rand -base64 32`), the same value the app holds. Every key
	// on the boundary — bearer, ticket signatures, callback signatures — is
	// derived from it, and it is never transmitted. `atoms dev` guarantees a
	// per-machine dev secret in the gitignored `.dev.vars`. Without a usable
	// secret every route but GET /healthz answers `misconfigured` (HTTP 500) —
	// a Worker without one is loudly broken, never open.
	//
	// ATOMS_BEARER_AUTH is `required` (the default) or `disabled`. `disabled` is
	// the explicit opt-out for a Worker behind an authenticating proxy such as
	// Cloudflare Access; it turns off the bearer comparison only, and tickets
	// and callbacks stay signed.
	//
	// ATOMS_DEBUG_ENDPOINTS is deliberately NOT set here, and should stay out:
	// these vars go into the generated config for every environment alike, so
	// a value here would turn the /debug routes on for staging and production
	// together. Set `"debug_endpoints": true` on one environment in atoms.json
	// instead; `atoms dev` and `atoms deploy` merge it into that environment's
	// vars. Under ATOMS_BEARER_AUTH=disabled that flag is the only gate in
	// front of /debug.
	"vars": {
		"ATOMS_LOG_LEVEL": "info"
	},

	"dev": { "port": 8787, "ip": "127.0.0.1" },
	"observability": { "enabled": true }
}
