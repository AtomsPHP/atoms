{
	"$schema": "node_modules/wrangler/config-schema.json",

	// The customer-facing Wrangler config: `scripts/pack-runtime.mjs` ships this
	// file as `wrangler.jsonc` in the @atomsphp/runtime-cloudflare template,
	// which `atoms init`/the deploy Action scaffold into `.atoms/worker`. The
	// sibling `wrangler.jsonc` in this repository is the conformance-harness
	// config and is NOT what customers receive — keep the two in sync when
	// changing anything module- or DO-shaped, and keep the differences (worker
	// name, debug endpoints) deliberate.
	//
	// NOTE: in a customer project this file lives in a gitignored, regenerated
	// directory (`.atoms/worker`), so local edits do not survive a re-scaffold.
	// Durable configuration belongs in atoms.json: `atoms dev` and
	// `atoms deploy` forward the settings there (for example
	// `"debug_endpoints": true`) as `wrangler --var` overrides.
	//
	// The name is cosmetic for `atoms deploy`, which selects the real Worker
	// with `--name` from atoms.json (`worker_name`, defaulting to the project).
	"name": "atoms-worker",
	"main": "src/index.js",
	"compatibility_date": "2026-08-01",

	// REQUIRED: the php-wasm Emscripten glue takes the ENVIRONMENT_IS_NODE
	// branch under workerd (process.release.name === 'node') and require()s
	// 'events'. Without nodejs_compat the module fails to load.
	"compatibility_flags": ["nodejs_compat"],

	// The pinned PHP runtime is bundled as a precompiled wasm module
	// (workerd forbids compiling bytes at runtime) and handed to Emscripten
	// through the instantiateWasm hook in src/php-host.js.
	"rules": [
		{ "type": "CompiledWasm", "globs": ["**/*.wasm"], "fallthrough": true },
		{ "type": "Text", "globs": ["**/*.php"], "fallthrough": true },
		{ "type": "Data", "globs": ["**/*.data", "**/*.so"], "fallthrough": true }
	],

	// One generic SQLite-backed Durable Object class for every Atom type:
	// atom type and id are application data, not DO class names.
	"durable_objects": {
		"bindings": [{ "name": "ATOMS", "class_name": "AtomDurableObject" }]
	},
	"migrations": [{ "tag": "v1", "new_sqlite_classes": ["AtomDurableObject"] }],

	// Operational values live in env, with defaults resolved in src/config.js.
	//
	// ATOMS_SHARED_SECRET is a secret, never a var here:
	// `wrangler secret put ATOMS_SHARED_SECRET` with the base64 of 32 random
	// bytes (`openssl rand -base64 32`), the same value the app holds. Every key
	// on the boundary — bearer, ticket signatures, callback signatures — is
	// derived from it, and it is never transmitted. `atoms dev` guarantees a
	// per-machine dev secret in the gitignored `.dev.vars`. Without a usable
	// secret every route but GET /healthz answers `misconfigured` (HTTP 500) —
	// a Worker without one is loudly broken, never open.
	//
	// ATOMS_BEARER_AUTH is `required` (the default) or `disabled`. `disabled` is
	// the explicit opt-out for a Worker behind an authenticating proxy such as
	// Cloudflare Access; it turns off the bearer comparison only, and tickets
	// and callbacks stay signed.
	//
	// ATOMS_DEBUG_ENDPOINTS is deliberately NOT set here: the /debug routes
	// default off (src/config.js). To turn them on, set
	// `"debug_endpoints": true` on the environment in atoms.json — not in this
	// file, which a re-scaffold overwrites.
	"vars": {
		"ATOMS_LOG_LEVEL": "info"
	},

	"dev": { "port": 8787, "ip": "127.0.0.1" },
	"observability": { "enabled": true }
}
