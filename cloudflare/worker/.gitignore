dist/

# Written by the CI worker job (and by anyone reproducing it locally) when it
# backgrounds `wrangler dev` and polls /healthz.
wrangler.log
wrangler.pid

# The php-wasm runtime is fetched from npm and staged here by
# scripts/prepare-runtime.mjs. Never commit it: the point of staging rather
# than vendoring is that this repository does not redistribute Playground's
# GPL-licensed PHP binary.
.php-wasm/

# Written by scripts/dev-with-callback.mjs: a fresh Ed25519 keypair generated
# for that one dev/CI session (public half + listener port only — the private
# seed never touches disk). Never commit a callback signing key.
test/.callback-key.json
