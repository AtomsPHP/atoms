{
    "name": "atoms/framework",
    "description": "Atoms framework monorepo: the customer-facing SDK packages, build toolchain, and adapters for the Atoms platform.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": "^8.3"
    },
    "require-dev": {
        "atoms/cli": "^0.8",
        "atoms/client": "^0.8",
        "atoms/core": "^0.8",
        "atoms/database-illuminate": "^0.8",
        "atoms/laravel": "^0.8",
        "atoms/phpstan-rules": "^0.8",
        "atoms/symfony": "^0.8",
        "atoms/testing": "^0.8",
        "doctrine/dbal": "^3.10 || ^4.4",
        "doctrine/doctrine-bundle": "^2.13 || ^3.0",
        "doctrine/doctrine-migrations-bundle": "^3.4.3",
        "doctrine/migrations": "^3.9",
        "guzzlehttp/psr7": "^2.7",
        "orchestra/testbench": "^9.0 || ^10.0 || ^11.0",
        "phpstan/phpstan": "^2.0",
        "phpunit/phpunit": "^11.5",
        "predis/predis": "^2.0 || ^3.0",
        "symfony/framework-bundle": "^7.4",
        "symfony/messenger": "^7.4"
    },
    "repositories": [
        {
            "type": "path",
            "url": "packages/*",
            "options": {
                "symlink": true
            }
        }
    ],
    "autoload-dev": {
        "psr-4": {
            "Atoms\\Core\\Tests\\": "packages/core/tests/",
            "Atoms\\Client\\Tests\\": "packages/client/tests/",
            "Atoms\\Laravel\\Tests\\": "packages/laravel/tests/",
            "Atoms\\Symfony\\Tests\\": "packages/symfony/tests/",
            "Atoms\\Testing\\Tests\\": "packages/testing/tests/",
            "Atoms\\PHPStan\\Tests\\": "packages/phpstan-rules/tests/",
            "Atoms\\Cli\\Tests\\": "packages/cli/tests/",
            "Atoms\\DatabaseIlluminate\\Tests\\": "packages/database-illuminate/tests/",
            "Atoms\\Examples\\PlainPhp\\": "examples/plain-php/src/",
            "Atoms\\Tests\\Integration\\": "tests/Integration/",
            "App\\": "examples/laravel/app/"
        }
    },
    "scripts": {
        "test": "@php -d memory_limit=1G vendor/bin/phpunit",
        "stan": "phpstan analyse --memory-limit=1G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "phpstan/extension-installer": false
        },
        "platform": {
            "php": "8.3.99"
        }
    },
    "prefer-stable": true
}
