{
    "$schema": "https://json-schema.org/draft/2020-12/schema",
    "$id": "https://atomsphp.dev/schemas/release-manifest.json",
    "title": "Atoms coordinated release manifest",
    "type": "object",
    "additionalProperties": false,
    "required": [
        "schema",
        "version",
        "status",
        "runtime",
        "php",
        "core",
        "composer"
    ],
    "properties": {
        "$schema": { "type": "string" },
        "schema": { "const": 1 },
        "version": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$" },
        "status": { "enum": ["candidate", "ready"] },
        "runtime": {
            "type": "object",
            "additionalProperties": false,
            "required": ["package", "version", "node", "wrangler", "guest_php"],
            "properties": {
                "package": { "const": "@atomsphp/runtime-cloudflare" },
                "version": { "type": "string" },
                "node": { "type": "string" },
                "wrangler": { "type": "string" },
                "guest_php": { "type": "string" }
            }
        },
        "php": {
            "type": "object",
            "additionalProperties": false,
            "required": ["constraint", "tested"],
            "properties": {
                "constraint": { "type": "string" },
                "tested": {
                    "type": "array",
                    "minItems": 1,
                    "uniqueItems": true,
                    "items": { "type": "string" }
                }
            }
        },
        "core": {
            "type": "object",
            "additionalProperties": false,
            "required": ["supported"],
            "properties": {
                "supported": { "type": "string" }
            }
        },
        "composer": {
            "type": "object",
            "additionalProperties": false,
            "required": ["packages"],
            "properties": {
                "packages": {
                    "type": "array",
                    "minItems": 8,
                    "maxItems": 8,
                    "uniqueItems": true,
                    "items": {
                        "enum": [
                            "atoms/core",
                            "atoms/client",
                            "atoms/laravel",
                            "atoms/symfony",
                            "atoms/testing",
                            "atoms/phpstan-rules",
                            "atoms/cli",
                            "atoms/database-illuminate"
                        ]
                    }
                }
            }
        }
    }
}
