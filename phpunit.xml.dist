<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
         failOnRisky="true"
         failOnWarning="true"
         cacheDirectory=".phpunit.cache">
    <testsuites>
        <testsuite name="core">
            <directory>packages/core/tests</directory>
        </testsuite>
        <testsuite name="client">
            <directory>packages/client/tests</directory>
        </testsuite>
        <testsuite name="laravel">
            <directory>packages/laravel/tests</directory>
        </testsuite>
        <testsuite name="symfony">
            <directory>packages/symfony/tests</directory>
        </testsuite>
        <testsuite name="testing">
            <directory>packages/testing/tests</directory>
        </testsuite>
        <testsuite name="phpstan-rules">
            <directory>packages/phpstan-rules/tests</directory>
        </testsuite>
        <testsuite name="cli">
            <directory>packages/cli/tests</directory>
        </testsuite>
        <testsuite name="integration">
            <directory>tests/Integration</directory>
        </testsuite>
    </testsuites>
    <php>
        <env name="APP_KEY" value="base64:AAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAA="/>
    </php>
    <source>
        <include>
            <directory>packages/core/src</directory>
            <directory>packages/client/src</directory>
            <directory>packages/laravel/src</directory>
            <directory>packages/symfony/src</directory>
            <directory>packages/testing/src</directory>
            <directory>packages/phpstan-rules/src</directory>
            <directory>packages/cli/src</directory>
        </include>
    </source>
</phpunit>
