---
import Base from '../layouts/Base.astro';
import AtomDiagram from '../components/AtomDiagram.astro';
---
<Base>
  <!-- ============================ hero ============================ -->
  <header class="hero">
    <div>
      <h1>Persistent <em>PHP objects</em>, inside Cloudflare <em class="o">Durable&nbsp;Objects</em>.</h1>
      <p class="sub">An Atom is a PHP class with its own SQLite database, running in a
        Durable Object on your Cloudflare account. Your Laravel or Symfony app calls it
        like a local object, and browsers can hold a WebSocket directly to it.</p>
      <div class="ctas">
        <a class="btn solid" href="https://github.com/AtomsPHP/atoms#install">Get started</a>
        <a class="btn ghost" href="https://github.com/AtomsPHP/atoms">GitHub</a>
      </div>
    </div>
    <AtomDiagram />
  </header>

  <!-- ============================ 1. the code ============================ -->
  <section id="code">
    <div class="cols">
      <div>
        <h2>This is an Atom</h2>
        <div class="prose" style="margin-top:1.1rem">
          <p>You write an ordinary PHP class and give it a database schema. You create
            one Atom per entity — a game room, a document, a tenant — each addressable
            by id, each handling one call at a time on data that lives in the same
            object.</p>
        </div>
        <div class="annos">
          <div class="anno app" data-for="a-join">
            <p class="anno-m">join()</p>
            <p>Your app calls this like any method. The seat check and the insert share
              a transaction, and because the Atom takes one call at a time, the count
              it read is still true when it writes.</p>
          </div>
          <div class="anno cli" data-for="a-onconnect">
            <p class="anno-m">onConnect()</p>
            <p>A player's browser opened its WebSocket. The connection gets tied to
              their seat, and the current board goes straight back down the wire.</p>
          </div>
          <div class="anno cli" data-for="a-onmessage">
            <p class="anno-m">onMessage()</p>
            <p>A move arrives over the socket. The UPDATE's WHERE clause is the
              referee — it matches only a piece the mover owns — and a move that
              landed is broadcast to everyone watching.</p>
          </div>
        </div>
      </div>
      <div>
        <div class="code-card">
          <p class="code-title">app/Atoms/GameRoom.php</p>
          <pre is:raw><span class="tok-k">namespace</span> App\Atoms;

<span class="tok-k">use</span> Atoms\Atom;
<span class="tok-k">use</span> Atoms\Database;
<span class="tok-k">use</span> Atoms\Websocket\Connection;
<span class="tok-k">use</span> Atoms\Websocket\Message;

<span class="tok-k">final class</span> <span class="tok-f">GameRoom</span> <span class="tok-k">extends</span> Atom
{
    <span class="tok-k">public function</span> <span class="tok-f" id="a-join">join</span>(<span class="tok-k">string</span> $player): <span class="tok-k">int</span>
    {
        $seat = $this-&gt;db()-&gt;transaction(<span class="tok-k">function</span> (Database $db) <span class="tok-k">use</span> ($player): <span class="tok-k">int</span> {
            $taken = (<span class="tok-k">int</span>) $db-&gt;query(<span class="tok-s">'SELECT COUNT(*) c FROM players'</span>)[0][<span class="tok-s">'c'</span>];

            <span class="tok-k">if</span> ($taken &gt;= 4) {
                <span class="tok-k">throw new</span> \DomainException(<span class="tok-s">'room_full'</span>);
            }

            $db-&gt;execute(<span class="tok-s">'INSERT INTO players (name, seat) VALUES (?, ?)'</span>, [$player, $taken + 1]);

            <span class="tok-k">return</span> $taken + 1;
        });

        $this-&gt;broadcast(<span class="tok-s">'room'</span>, [<span class="tok-s">'kind'</span> =&gt; <span class="tok-s">'joined'</span>, <span class="tok-s">'player'</span> =&gt; $player, <span class="tok-s">'seat'</span> =&gt; $seat]);

        <span class="tok-k">return</span> $seat;
    }

    <span class="tok-k">public function</span> <span class="tok-f" id="a-onconnect">onConnect</span>(Connection $conn, <span class="tok-k">array</span> $params): <span class="tok-k">void</span>
    {
        $this-&gt;db()-&gt;execute(
            <span class="tok-s">'UPDATE players SET connection_id = ? WHERE name = ?'</span>,
            [$conn-&gt;id(), $params[<span class="tok-s">'client_id'</span>]]
        );

        $conn-&gt;sendJson([
            <span class="tok-s">'kind'</span>  =&gt; <span class="tok-s">'welcome'</span>,
            <span class="tok-s">'board'</span> =&gt; $this-&gt;db()-&gt;query(<span class="tok-s">'SELECT piece, square, owner FROM board'</span>),
        ]);
    }

    <span class="tok-k">public function</span> <span class="tok-f" id="a-onmessage">onMessage</span>(Connection $conn, Message $msg): <span class="tok-k">void</span>
    {
        $move = $msg-&gt;json();

        $moved = $this-&gt;db()-&gt;execute(
            <span class="tok-s">'UPDATE board SET square = ?
              WHERE piece = ?
                AND owner = (SELECT name FROM players WHERE connection_id = ?)'</span>,
            [$move[<span class="tok-s">'square'</span>], $move[<span class="tok-s">'piece'</span>], $conn-&gt;id()]
        );

        <span class="tok-k">if</span> ($moved === 1) {
            $this-&gt;broadcast(<span class="tok-s">'room'</span>, [<span class="tok-s">'kind'</span> =&gt; <span class="tok-s">'moved'</span>] + $move);
        }
    }
}</pre>
        </div>
        <div class="code-card">
          <p class="code-title">anywhere in your app</p>
          <pre is:raw>$seat = Atoms::get(GameRoom::class, <span class="tok-s">'room-42'</span>)-&gt;join(<span class="tok-s">'ada'</span>);</pre>
        </div>
        <p class="cap">That's the Laravel facade. Symfony and plain PHP use the same
          client without it — inject <code>AtomsClient</code> and call
          <code>get()</code> the same way.</p>
      </div>
    </div>
  </section>

  <!-- ============================ 2. live ============================ -->
  <section id="live">
    <div class="cols">
      <div>
        <h2>Browsers connect to the same object</h2>
        <div class="prose" style="margin-top:1.1rem">
          <p>An Atom can hold WebSocket connections itself. Every browser watching
            <code>room-42</code> is connected to the one object that owns room 42's
            state, so when it calls <code>broadcast()</code>, everyone sees the change —
            the sockets and the data live in the same place, so they always agree.</p>
          <p>Your app mints a short-lived ticket and hands the browser a URL; the
            browser just opens it.</p>
        </div>
      </div>
      <div>
        <div class="code-card">
          <p class="code-title">in the browser</p>
          <pre is:raw><span class="tok-k">const</span> { url } = <span class="tok-k">await</span> (<span class="tok-k">await</span> fetch(<span class="tok-s">'/api/rooms/room-42/socket'</span>, { method: <span class="tok-s">'POST'</span> })).json();

<span class="tok-k">const</span> ws = <span class="tok-k">new</span> WebSocket(url);
ws.onmessage = (e) =&gt; render(JSON.parse(e.data));</pre>
        </div>
        <p class="cap">The URL comes from <code>Atoms::wsUrl()</code>, ticket
          included.</p>
      </div>
    </div>
  </section>

  <!-- ============================ 2b. auth ============================ -->
  <section id="auth">
    <div class="cols">
      <div>
        <h2>Who gets a socket</h2>
        <div class="prose" style="margin-top:1.1rem">
          <p>A browser gets a socket only with a short-lived ticket, minted by your app
            in a normal authenticated route — and the ticket's job ends at the
            handshake. After that, messages flow straight between browser and Atom;
            your app is back in the loop only if the connection drops.</p>
        </div>
      </div>
      <div>
        <div class="code-card">
          <p class="code-title">routes/api.php — a normal authenticated route</p>
          <pre is:raw>Route::middleware(<span class="tok-s">'auth'</span>)-&gt;post(<span class="tok-s">'/rooms/{room}/socket'</span>, <span class="tok-k">function</span> (<span class="tok-k">string</span> $room) {
    <span class="tok-k">return</span> [<span class="tok-s">'url'</span> =&gt; Atoms::wsUrl(GameRoom::class, $room, [
        <span class="tok-s">'channels'</span> =&gt; [<span class="tok-s">'room'</span>],
        <span class="tok-s">'ticket'</span>   =&gt; (<span class="tok-k">string</span>) Atoms::ticket(GameRoom::class, $room, [
            <span class="tok-s">'client_id'</span> =&gt; (<span class="tok-k">string</span>) auth()-&gt;id(),
        ]),
    ])];
});</pre>
        </div>
        <p class="cap">Ticket claims override the URL's query string, so
          <code>$params['client_id']</code> in <code>onConnect</code> is the identity
          your server asserted — the browser can't forge it.</p>
      </div>
    </div>
  </section>

  <!-- ============================ 3. how it works ============================ -->
  <section id="how">
    <h2>How it works</h2>
    <div class="prose" style="margin-top:1.1rem">
      <p>Your Atom classes stay in your repository, next to the rest of your app. A
        build step extracts them into a bundle, and a deploy ships that bundle to a
        Worker in your Cloudflare account, where each Atom id gets its own Durable
        Object running PHP 8.3 compiled to WebAssembly — with its SQLite database
        stored durably beside it.</p>
    </div>
    <div class="pipeline">
      <div class="station">
        <p class="code-title">your repo</p>
        <p>Atom classes live in your app. <code>atoms build</code> extracts them into a
          bundle — deterministically, without ever executing your code.</p>
      </div>
      <div class="pipe-arrow" aria-hidden="true">
        <svg width="46" height="12" viewBox="0 0 46 12"><line x1="2" y1="6" x2="36" y2="6"></line><polygon points="36,1.5 44,6 36,10.5"></polygon></svg>
      </div>
      <div class="station">
        <p class="code-title">atoms deploy</p>
        <p>The CLI drives the Wrangler already pinned in your project. Your Cloudflare
          credentials go to Wrangler and nowhere else.</p>
      </div>
      <div class="pipe-arrow" aria-hidden="true">
        <svg width="46" height="12" viewBox="0 0 46 12"><line x1="2" y1="6" x2="36" y2="6"></line><polygon points="36,1.5 44,6 36,10.5"></polygon></svg>
      </div>
      <div class="station">
        <p class="code-title">your cloudflare account</p>
        <p>One Durable Object per Atom id: PHP in WebAssembly, SQLite stored durably
          beside it, WebSockets and timers handled by the platform.</p>
      </div>
    </div>
    <p class="cap" style="margin-top:1.4rem">Local development is
      <code>atoms dev</code> — the same runtime on your machine, no Cloudflare account
      required.</p>
  </section>

  <!-- ============================ 4. why ============================ -->
  <section id="why">
    <h2>Why you'd reach for it</h2>
    <div class="quads">
      <div class="quad">
        <h3>Wired into your app, both directions</h3>
        <p>Your controllers call an Atom's methods the way they'd call any object's,
          and an Atom talks back the same way — it can invoke methods in your app and
          queue jobs on your app's queue. The whole bridge between monolith and
          Durable Object comes built, and it speaks PHP at both ends.</p>
      </div>
      <div class="quad">
        <h3>Real-time, without leaving PHP</h3>
        <p>Multiplayer, presence, live dashboards — the features that usually mean
          bolting a Node service or a hosted pub/sub onto your monolith. An Atom holds
          the sockets and the state in one place, in the language your team already
          writes.</p>
      </div>
      <div class="quad">
        <h3>State that can't race</h3>
        <p>Some entities are fights waiting to happen — a seat map, an auction, a
          shared cart. Give each one an Atom and consistency comes built in: one
          object, one call at a time, its own SQLite database.</p>
      </div>
      <div class="quad">
        <h3>Scale that runs itself</h3>
        <p>Every entity gets its own object with its own database, so a thousand rooms
          are a thousand small databases, each carrying only its own load. Idle Atoms
          hibernate, and Cloudflare handles placement and wake-up for you.</p>
      </div>
    </div>
  </section>

  <!-- ============================ 5. trust ============================ -->
  <section id="trust">
    <h2>Built carefully, in the open</h2>
    <ul class="trust">
      <li><b>It's yours.</b> MIT-licensed, and deployed to your own Cloudflare account —
        no Atoms-run service sits in any path, and your credentials never pass through
        anything we operate.</li>
      <li><b>Builds you can audit.</b> The same tree always produces the same bundle,
        and building never executes your code.</li>
      <li><b>A runtime held to a spec.</b> Every change to the Worker has to clear a
        conformance suite of 43 checks before it lands.</li>
      <li><b>Errors that tell you what to do.</b> Every failure in every package
        carries a stable code and a fix line, kept in one catalog.</li>
    </ul>
  </section>

  <!-- ============================ status aside ============================ -->
  <div class="status">
    <p>Atoms is new. The API your code sits on is stable and only grows, but the rest
      is still settling on the way to 1.0.</p>
  </div>

  <!-- ============================ 6. get started ============================ -->
  <section id="start" class="start">
    <h2>Get started</h2>
    <div class="code-card">
      <pre is:raw><span class="tok-c">$</span> composer require atoms/laravel
<span class="tok-c">$</span> php artisan atoms:install
<span class="tok-c">$</span> npm exec --yes --package=@atomsphp/runtime-cloudflare -- \
    atoms-runtime-cloudflare init .atoms/worker

<span class="tok-c">$</span> vendor/bin/atoms dev      <span class="tok-c"># local, no Cloudflare account needed</span>
<span class="tok-c">$</span> vendor/bin/atoms deploy   <span class="tok-c"># to your own account</span></pre>
    </div>
    <div class="ctas">
      <a class="btn solid" href="https://github.com/AtomsPHP/atoms#install">Read the guide</a>
      <a class="btn ghost" href="https://github.com/AtomsPHP/atoms">Star on GitHub</a>
    </div>
  </section>
</Base>

<script is:inline>
// Line each annotation up with its method in the code card.
(function(){
  'use strict';
  function align(){
    var annos = document.querySelectorAll('.anno[data-for]');
    annos.forEach(function(a){ a.style.marginTop = ''; });
    if (window.innerWidth <= 860) return;
    annos.forEach(function(a){
      var anchor = document.getElementById(a.getAttribute('data-for'));
      if (!anchor) return;
      var delta = anchor.getBoundingClientRect().top - a.getBoundingClientRect().top;
      if (delta > 0) a.style.marginTop = delta + 'px';
    });
  }
  window.addEventListener('resize', align);
  if (document.fonts && document.fonts.ready) document.fonts.ready.then(align);
  align();
})();
</script>
